<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/playback_widget_background">
    <LinearLayout android:id="@+id/widget_metadata"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical">
        <ImageView android:layout_width="40dp" android:layout_height="40dp"
            android:src="@mipmap/ic_launcher" android:contentDescription="EmoC" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="EmoC" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_artist" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#B9C5C0"
                android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center">
        <ImageButton android:id="@+id/widget_previous" android:layout_width="64dp" android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous" android:tint="#FFFFFF"
            android:background="?android:attr/selectableItemBackground" android:contentDescription="上一首" />
        <ImageButton android:id="@+id/widget_play" android:layout_width="64dp" android:layout_height="48dp"
            android:src="@android:drawable/ic_media_play" android:tint="#8DE0B0"
            android:background="?android:attr/selectableItemBackground" android:contentDescription="播放" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="64dp" android:layout_height="48dp"
            android:src="@android:drawable/ic_media_next" android:tint="#FFFFFF"
            android:background="?android:attr/selectableItemBackground" android:contentDescription="下一首" />
    </LinearLayout>
</LinearLayout>
